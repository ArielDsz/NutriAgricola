# Supabase PostgreSQL: usa el host y usuario del modo Session pooler.
# Reemplaza <POOLER_HOST> y <POOLER_USER> con los valores de Dashboard > Connect.
DB_URL=jdbc:postgresql://<POOLER_HOST>:5432/postgres?sslmode=require
DB_USERNAME=<POOLER_USER>
DB_PASSWORD=REEMPLAZAR_CON_LA_CONTRASENA_DE_BASE_DE_DATOS

# Clave aleatoria en Base64 de al menos 32 bytes; no reutilices una clave de ejemplo.
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_BASE64_DE_32_BYTES
